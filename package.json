{
  "name": "workflow-hub-tooling",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:contract": "redocly lint --config .redocly.yaml contracts/openapi.yaml",
    "check": "npm run format:check && npm run lint:contract",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "setup:skills": "node scripts/setup-skills.mjs",
    "test:tooling": "node --test scripts/check-pr-title.test.mjs scripts/setup-skills.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.82.0",
    "prettier": "3.10.1"
  }
}
