# Export these into the process environment. Spring does not auto-load this file.
PORT=8080
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWKS_URI=http://localhost:54321/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL connection used by the backend and Flyway at startup.
DATABASE_URL=jdbc:postgresql://localhost:5432/workflow_hub
DATABASE_USERNAME=workflow_hub
DATABASE_PASSWORD=
# Private S3 bucket for original workflow files. Credentials come from the default AWS provider chain.
AWS_REGION=ap-northeast-2
# 필수(비어 있으면 시작되지 않는다). S3는 업로드와 원본 다운로드 요청을 처리할 때 호출하므로, 해당 기능을 사용하지 않는 로컬 실행에서는 아무 버킷 이름이나 지정할 수 있다.
WORKFLOW_BUCKET=
# Swagger UI(/swagger-ui.html)와 /v3/api-docs를 인증 없이 노출한다. 로컬에서만 true로 바꾸고 배포 환경에는 복사하지 않는다.
API_DOCS_ENABLED=false
# 업로드·버전 등록이 실패하고 남은 S3 객체를 정리하기까지의 대기 시간과 삭제 실패 시 재시도 간격. 대기 시간은 요청 하나의 최대 소요보다 충분히 길어야 하며 S3_CALL_TIMEOUT의 2배 미만이면 앱이 시작되지 않는다.
PENDING_OBJECT_GRACE=30m
CLEANUP_RETRY_DELAY=5m
PENDING_OBJECT_CLEANUP_INTERVAL=10s
# 버전·워크플로를 삭제한 뒤 S3 원본을 지우기까지의 복구 기간. 이 기간 안에는 소유자가 복구할 수 있다. 0 이하이면 앱이 시작되지 않는다.
WORKFLOW_DELETE_GRACE=7d
# n8n JSON 입력 한도(최초 업로드와 버전 비교에 공통 적용). 한도에 도달한 입력은 통과하고 초과하면 422 WORKFLOW_LIMIT_EXCEEDED다. 노드·연결은 1 이상, 깊이는 6 이상이어야 하며 어기거나 숫자가 아니면 앱이 시작되지 않는다. 값은 서버 사양(CPU)에 맞춘 측정 결과이므로 올릴 때는 docs/INPUT_LIMITS.md를 확인한다.
WORKFLOW_MAX_DEPTH=64
WORKFLOW_MAX_NODES=300
WORKFLOW_MAX_CONNECTIONS=1500
# 보안 검사 작업 발행 SQS 큐 URL과 워커 내부 API(/internal/worker/v1/**) 전용 Bearer 토큰(쉼표로 복수 활성 토큰 회전 지원).
# 둘 다 필수(비어 있으면 시작되지 않는다). 토큰에 공백·제어 문자가 있으면 시작되지 않는다. 보안 검사 기능을 호출하지 않는 로컬 실행에서는 임의 더미 값을 지정할 수 있다.
SCAN_QUEUE_URL=
WORKER_API_TOKENS=
# 보안 검사 임대 시간, 미수신 queued 회수 대기 시간, 최대 시도 횟수, 만료 회수 주기. 0 이하이면 앱이 시작되지 않는다.
SCAN_LEASE_DURATION=60s
SCAN_QUEUED_TIMEOUT=5m
SCAN_MAX_ATTEMPTS=3
SCAN_LEASE_RECOVERY_INTERVAL=15s
# 발행이 확인되지 않은 queued 시도를 같은 attemptId로 다시 발행하기까지의 간격. SQS_CALL_TIMEOUT(기본 30s)보다 길고 SCAN_QUEUED_TIMEOUT보다 짧아야 시작된다.
SCAN_DISPATCH_RETRY_DELAY=1m
